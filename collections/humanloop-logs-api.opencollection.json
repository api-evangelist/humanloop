{
  "opencollection": "1.0.0",
  "info": {
    "name": "Humanloop Datasets Logs API",
    "version": "5.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.humanloop.com/v5/logs"
          },
          "docs": "List Logs"
        },
        {
          "info": {
            "name": "Get Log",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.humanloop.com/v5/logs/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Log"
        }
      ]
    }
  ],
  "bundled": true
}